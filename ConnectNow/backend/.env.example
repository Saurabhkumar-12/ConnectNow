# ConnectNOW Backend Environment Configuration Template

# Server Port
PORT=8000

# Node Environment (development | production)
NODE_ENV=production

# MongoDB Connection URI (local or Atlas)
MONGO_URL=mongodb+srv://<db_username>:<db_password>@cluster0.example.mongodb.net/connectnow?retryWrites=true&w=majority

# JWT Secret Key for token signing (REQUIRED IN PRODUCTION)
JWT_SECRET=your_production_secure_random_jwt_secret_32bytes_min

# Frontend Client URL
FRONTEND_URL=https://connectnow-meet.vercel.app

# Trust Proxy (1 for single reverse proxy like Nginx/Vercel/Cloudflare)
TRUST_PROXY=1

# Rate Limiting Configuration
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=15
AUTH_ACCOUNT_RATE_LIMIT_MAX=5
USER_RATE_LIMIT_WINDOW_MS=60000
USER_RATE_LIMIT_MAX=100
PUBLIC_RATE_LIMIT_WINDOW_MS=60000
PUBLIC_RATE_LIMIT_MAX=200
BACKOFF_BASE_MS=2000
BACKOFF_MAX_MS=300000

